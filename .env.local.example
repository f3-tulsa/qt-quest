# Copy this file to .env.local and fill in your Firebase project values.
# .env.local is gitignored — never commit real keys.

# Firebase project config (Project settings > General > Your apps > SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you enabled Google Analytics for the project
VITE_FIREBASE_MEASUREMENT_ID=

# Simple client-side gate code for /marshal — pick anything, tell your marshals
VITE_MARSHAL_CODE=
