rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public punchcard state — anyone with the access code (doc id) can
    // read/write. This is intentionally low-security/obscurity-based for a
    // casual community race; codes are not guessable/short and not indexed
    // publicly. Do not store anything sensitive here.
    match /participants/{code} {
      allow read, write: if true;
    }

    // Emergency contact / medical info — gated behind Firebase Anonymous
    // Auth as a soft speed bump only. NOTE: because the Firebase web config
    // is public in the deployed bundle, anyone could sign in anonymously and
    // read this too. This is not real security, just reduces casual
    // exposure to search engines / accidental link sharing.
    match /participants_private/{code} {
      allow read, write: if request.auth != null;
    }
  }
}
